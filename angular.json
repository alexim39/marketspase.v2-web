            "index": "projects/admin/src/index.html",
            "browser": "projects/admin/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/admin/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/assets/brand",
                "output": "/logo"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/shared/assets/brand",
                "output": "/"
              }
            ],
            "styles": [
              "projects/admin/src/styles.scss",
              "node_modules/@fontsource-variable/inter/wght.css",
              "node_modules/@fontsource/material-icons/latin.css"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/admin/src/environments/environment.ts",
                  "with": "projects/admin/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
