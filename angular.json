{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "1b5fc0db-4f2b-49c1-bb14-2f32671056fa"
  },
  "newProjectRoot": "projects",
  "projects": {
    "platform": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/platform",
      "sourceRoot": "projects/platform/src",
      "prefix": "async",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/platform",
            "index": "projects/platform/src/index.html",
            "browser": "projects/platform/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/platform/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/platform/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/assets/brand",
                "output": "/logo"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/shared/assets/brand",
                "output": "/"
              }
            ],
            "styles": [
              "projects/platform/src/styles.scss",
              "node_modules/@fontsource-variable/inter/wght.css",
              "node_modules/@fontsource/material-icons/latin.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/platform/src/environments/environment.ts",
                  "with": "projects/platform/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "9kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "proxyConfig": "projects/platform/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "platform:build:production"
            },
            "development": {
              "buildTarget": "platform:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "store": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/store",
      "sourceRoot": "projects/store/src",
      "prefix": "async",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/store",
            "index": "projects/store/src/index.html",
            "browser": "projects/store/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/store/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/store/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/assets/brand",
                "output": "/logo"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/shared/assets/brand",
                "output": "/"
              }
            ],
            "styles": [
              "projects/store/src/theme.scss",
              "projects/store/src/styles.scss",
              "node_modules/sweetalert2/dist/sweetalert2.min.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "sweetalert2"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/store/src/environments/environment.ts",
                  "with": "projects/store/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "store:build:production"
            },
            "development": {
              "buildTarget": "store:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/store/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/store/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/assets/brand",
                "output": "/logo"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/shared/assets/brand",
                "output": "/"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/store/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "async",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
