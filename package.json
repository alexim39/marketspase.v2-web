{
  "name": "marketspase-v2-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve platform",
    "start:platform": "ng serve platform",
    "start:store": "ng serve store",
    "start:admin": "ng serve admin",
    "build": "npm run build:platform && npm run build:store && npm run build:admin",
    "build:platform": "ng build platform",
    "build:store": "ng build store && node projects/store/scripts/generate-static-meta.mjs",
    "build:admin": "ng build admin",
    "watch:platform": "ng build platform --watch --configuration development",
    "watch:store": "ng build store --watch --configuration development",
    "watch:admin": "ng build admin --watch --configuration development",
    "test:store": "ng test store --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:admin": "ng test admin --watch=false",
    "check:legacy-endpoints": "node scripts/check-legacy-endpoints.mjs",
    "check:internal-links": "node scripts/check-internal-links.mjs",
    "ci": "npm run check:legacy-endpoints && npm run check:internal-links && npm run build && npm run test:store && npm run test:admin"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/material-icons": "^5.3.0",
    "echarts": "^6.1.0",
    "ngx-device-detector": "^12.0.0",
    "ngx-echarts": "^22.0.0",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "sweetalert2": "^11.7.27",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "jsdom": "^30.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
